#include <iostream>
 using namespace std;
 int main() {
    setlocale(LC_ALL, "Rus");
    int x;
    int cur_len = 0;    
    int max_len = 0;     
    int prev = -1;       
    bool has_valid = false;  
    cout << "Вводите суточный расход (0..100), для завершения введите -1:" << endl;
    cin >> x;
    while (x != -1) {
        if (x >= 0 && x <= 100) {
            if (!has_valid) {
          has_valid = true;
          cur_len = 1;
          max_len = 1;
            }
            else {
                if (x > prev) {
                    cur_len++;
                }
                else {
                    cur_len = 1;  
                }

                if (cur_len > max_len) {
                    max_len = cur_len;
                }
            }
            prev = x;
        }
        cin >> x;
    }

    cout << "Максимальная длина возрастающей последовательности: " << max_len << endl;

    return 0;
}
